<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><LangVersion>9.0</LangVersion><IsPackable>false</IsPackable>
  <EnableDefaultCompileItems>false</EnableDefaultCompileItems><DefineConstants>UNITY_INCLUDE_TESTS;ENABLE_LEGACY_INPUT_MANAGER</DefineConstants><NoWarn>CS1701;CS1702;MSB3277;NU1701</NoWarn></PropertyGroup>
  <ItemGroup><Compile Include="$(MSBuildThisFileDirectory)../../../Assets/Tests/EditMode/**/*.cs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Runtime/Runtime.csproj" />
    <Reference Include="$(MSBuildThisFileDirectory)../../.cache/refs/unityengine.modules/lib/net45/*.dll" Exclude="$(MSBuildThisFileDirectory)../../.cache/refs/unityengine.modules/lib/net45/UnityEngine.dll" />
    <PackageReference Include="NUnit" Version="3.14.0" /><PackageReference Include="NUnit3TestAdapter" Version="4.5.0" /><PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>
</Project>
